@page "/account/login"
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<h1>Sign in</h1>

@if (Model.Error is not null)
{
    <p class="error" role="alert">@Model.Error</p>
}

<form method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    <label for="username">Username</label>
    <input id="username" asp-for="Username" autocomplete="username" autofocus required />
    <label for="password">Password</label>
    <input id="password" asp-for="Password" type="password" autocomplete="current-password" required />
    <button type="submit">Sign in</button>
</form>
