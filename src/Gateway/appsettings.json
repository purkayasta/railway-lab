{
  "Auth": {
    "Authority": "http://localhost:8180",
    "Issuer": "http://localhost:8180/",
    "Audience": "railway-api",
    "RequireHttpsMetadata": false
  },
  "RateLimit": {
    "WindowSeconds": 60,
    "AuthenticatedPerWindow": 600,
    "AnonymousPerWindow": 60
  },
  "ReverseProxy": {
    "Routes": {
      "reservation-hub": {
        "ClusterId": "reservation",
        "Match": { "Path": "/hubs/seats/{**rest}" }
      },
      "auth": {
        "ClusterId": "auth",
        "Match": {
          "Path": "/api/auth/{**rest}"
        }
      },
      "reservation": {
        "ClusterId": "reservation",
        "Match": { "Path": "/api/reservation/{**rest}" },
        "Transforms": [{ "PathRemovePrefix": "/api/reservation" }]
      },
      "schedule": {
        "ClusterId": "schedule",
        "Match": {
          "Path": "/api/schedule/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/schedule"
          }
        ]
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": {
          "d1": {
            "Address": "http://auth:8080"
          }
        }
      },
      "reservation": {
        "Destinations": { "d1": { "Address": "http://reservation:8080" } }
      },
      "schedule": {
        "Destinations": {
          "d1": {
            "Address": "http://schedule:8080"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
